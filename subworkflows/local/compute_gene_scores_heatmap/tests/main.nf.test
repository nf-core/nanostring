nextflow_workflow {

    name "Test Subworkflow COMPUTE_GENE_SCORES_HEATMAP"
    script "../main.nf"
    workflow "COMPUTE_GENE_SCORES_HEATMAP"

    tag "subworkflows"
    tag "compute_gene_scores_heatmap"

    test("test profile") {
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [id:"test"],
                    file(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/normalized_counts.tsv', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [id:"test"],
                    file(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/counts_Norm_GEX_ENDO.tsv', checkIfExists: true)
                ])
                input[2] = Channel.fromPath(params.pipelines_testdata_base_path + 'nanostring/gene_score_test.yaml', checkIfExists: true)
                input[3] = Channel.empty()
                input[4] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out.versions).match("versions") },
                { assert workflow.out.multiqc_files.size() >= 1 },
                { assert workflow.out.multiqc_files.flatten().any {
                    file(it).name.contains("signature_scores")
                }},
                { assert workflow.out.multiqc_files.flatten().any {
                    file(it).name.endsWith("_mqc.txt")
                }},
                { assert snapshot(
                    workflow.out.multiqc_files.flatten().collect { file(it).name }.sort()
                ).match("output_filenames_filter") }
            )
        }
    }

    test("test profile filter") {
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [id:"test"],
                    file(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/normalized_counts.tsv', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [id:"test"],
                    file(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/counts_Norm_GEX_ENDO.tsv', checkIfExists: true)
                ])
                input[2] = Channel.fromPath(params.pipelines_testdata_base_path + 'nanostring/gene_score_test.yaml', checkIfExists: true)
                input[3] = Channel.fromPath(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/genes_to_filter.yml', checkIfExists: true)
                input[4] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out.versions).match("versions_filter") },
                { assert workflow.out.multiqc_files.size() >= 1 },
                { assert workflow.out.multiqc_files.flatten().any {
                    file(it).name.contains("signature_scores")
                }},
                { assert workflow.out.multiqc_files.flatten().any {
                    file(it).name.endsWith("_mqc.txt")
                }},
                { assert snapshot(
                    workflow.out.multiqc_files.flatten().collect { file(it).name }.sort()
                ).match("output_filenames") }
            )
        }
    }

    test("skip heatmap") {
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [id:"test"],
                    file(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/normalized_counts.tsv', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [id:"test"],
                    file(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/counts_Norm_GEX_ENDO.tsv', checkIfExists: true)
                ])
                input[2] = Channel.fromPath(params.pipelines_testdata_base_path + 'nanostring/gene_score_test.yaml', checkIfExists: true)
                input[3] = Channel.fromPath(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/genes_to_filter.yml', checkIfExists: true)
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.gene_heatmaps.size() == 0 },
                { assert !workflow.trace.tasks().any { it.name.contains('CREATE_GENE_HEATMAP') } },
                { assert snapshot(
                    workflow.out.versions,
                    workflow.out.multiqc_files.flatten().collect { file(it).name }.sort()
                ).match() }
            )
        }
    }

    test("stub") {
        options '-stub'
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [id:"test"],
                    file(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/normalized_counts.tsv', checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [id:"test"],
                    file(params.pipelines_testdata_base_path + 'nanostring/modules_test_data/test_profile/counts_Norm_GEX_ENDO.tsv', checkIfExists: true)
                ])
                input[2] = Channel.fromPath(params.pipelines_testdata_base_path + 'nanostring/gene_score_test.yaml', checkIfExists: true)
                input[3] = Channel.empty()
                input[4] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success},
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
